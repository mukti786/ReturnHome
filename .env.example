# Backend
PORT=5000
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# Required for account storage and protected APIs
MONGO_URI=mongodb://127.0.0.1:27017/returnhome
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Local-only demo access (off by default). Use only with `NODE_ENV=development` and `npm run dev` in backend.
DEV_AUTH_BYPASS=false
# Set to true in frontend/.env.local only when Vite is running in development and backend demo access is enabled.
# This VITE-prefixed value is public and is not an authentication secret.
# VITE_DEV_AUTH_BYPASS=false

# Optional initial administrator for the non-destructive seed command
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_ORGANIZATION=

# AI service and uploads
AI_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_STORAGE_PATH=./uploads

# SMTP settings are not currently enough to enable password recovery; email delivery is not implemented.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=


